@startuml d1-informationsmodell
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 11
skinparam ArrowColor #555555
skinparam classAttributeIconSize 0
skinparam nodesep 25
skinparam ranksep 55
skinparam class {
  BackgroundColor #F7F7F7
  BorderColor #333333
}
skinparam package {
  BorderColor #999999
  BackgroundColor #FFFFFF
}
hide circle
hide methods

title D1 Informationsmodell NextTask: Kernentitaeten (Detailentitaeten in D1.3 und D1.4)

package "Projekte und Berichtswesen" {
  class Project {
    key : Text (eindeutig)
    name : Text
    projectType, visibility, statusLabel : Text [0..1]
    plannedStart, plannedEnd : Datum [0..1]
    plannedEffortPt : PT [0..1]
    plannedBudget : EUR [0..1]
    reportCycle : ReportCycleDT
  }
  class ProjectMilestone {
    title : Text
    planDate, newDate : Datum [0..1]
    status : MilestoneStatusDT
    progress : Prozent
  }
  class ProjectRisk {
    code : Text
    impact, probability : Integer [0..1]
    riskClass : RiskClassDT [0..1]
    trend : RiskTrendDT [0..1]
    measure : Text [0..1]
  }
  class ProjectInterface {
    name : Text
    status : InterfaceStatusDT
    comment : Text [0..1]
  }
  class ProjectApproval {
    projectResponsible, gbl,\nprojectLead : Text [0..1]
    approvalDate : Datum [0..1]
  }
  class ProjectBudgetLine {
    category : Text
    plannedAmount, actualAmount : EUR
  }
  class ProjectStatusReport {
    reportDate : Datum
    progress : Prozent
    goalStatus, scheduleStatus,\nresourceStatus, budgetStatus : AmpelDT [0..1]
    actualEffortPt : PT [0..1]
    actualBudget : EUR [0..1]
  }
}

package "Organisation und Zugang" {
  class Department {
    code : Text (eindeutig) [0..1]
    name : Text
    businessArea : Text [0..1]
    leadName : Text
    memberCount : Integer
  }
  class DepartmentMember {
    name : Text
    roleLabel : Text [0..1]
    order : Integer
  }
  class AccessRole {
    code : Text (eindeutig)
    kind : AccessRoleKindDT
    businessAreas : Text[*]
    departmentIds : Identifier[*]
    permissions : PermissionSetDT
    system : Boolean
  }
  class User {
    email : Email (eindeutig)
    name : Text
    department : Text
    role : UserRoleDT
    authProvider : AuthProviderDT
    twoFactorEnabled : Boolean
  }
  class SsoLoginTicket {
    tokenHash : Text (eindeutig)
    expiresAt : Zeitstempel
  }
}

package "Aufgaben" {
  class Task {
    title : Text
    ticketNumber : Text [0..1]
    status : TaskStatusDT
    priority : PriorityDT
    order : Integer
    progress : Prozent
    startDate, dueDate, endDate : Datum [0..1]
    estimatedHours : Stunden [0..1]
    approvalLevel : ApprovalLevelDT [0..1]
    favoriteBy : Text[*]
  }
  class Comment {
    content : Text
  }
  class TaskMarker {
    label : Text
    color : Farbe
    matchField : MatchFieldDT
  }
  class CalendarSyncEvent {
    provider : CalendarProviderDT
    externalEventId : Text
  }
}

package "Steuerung und Nachweis" {
  class ApprovalRequest {
    entityType : ApprovalEntityTypeDT
    entityId : Identifier
    status : ApprovalStatusDT
    evidence, decisionNote : Text [0..1]
    requestedAt, decidedAt : Zeitstempel
  }
  class AuditLog {
    action : Text
    severity : SeverityDT
    before, after : JSON [0..1]
    actorName : Text
    createdAt : Zeitstempel
  }
}

' Organisation
AccessRole "0..1" -- "*" User : hat Zugriffsrolle
User "1" *-- "*" SsoLoginTicket
Department "1" *-- "*" DepartmentMember
User "0..1" -- "*" Department : Leitung
AccessRole "*" ..> "*" Department : departmentIds\n(lose Referenz)

' Projekte
User "1" -left- "*" Project : Eigentuemer
Department "0..1" -- "*" Project : gehoert zu
Project "1" *-- "*" ProjectMilestone
Project "1" *-- "*" ProjectRisk
Project "1" *-- "*" ProjectInterface
Project "1" *-- "0..1" ProjectApproval
Project "1" *-- "*" ProjectBudgetLine
Project "1" *-- "*" ProjectStatusReport

' Aufgaben
Project "1" *-- "*" Task
User "0..1" -right- "*" Task : Bearbeiter
Task "0..1" -- "*" Task : parentTask
Task "1" *-- "*" Comment
User "1" *-- "*" TaskMarker
Task "*" ..> "0..1" TaskMarker : markerId\n(lose Referenz)
Task "1" *-- "*" CalendarSyncEvent

' Steuerung
ApprovalRequest "*" -- "1" User : Anfragender
ApprovalRequest "*" -- "0..1" User : Genehmiger

legend bottom right
  Nicht gezeichnet (siehe Attributtabellen): Autor von Statusbericht
  und Kommentar, Besitzer eines Kalenderabgleichs, Akteur eines
  Audit-Eintrags (alle -> User). Die Detailentitaeten der Aufgabe
  (Tags, Anhaenge, Compliance, ...) und die Dokumente stehen im
  zweiten Diagramm (D1.3, D1.4).
end legend
@enduml
