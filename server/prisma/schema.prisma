generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  QA
  BLOCKED
  DONE
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  QA
  DESIGNER
  MARKETING
}

enum AccessRoleKind {
  ADMIN
  GBL
  MEMBER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalEntityType {
  TASK
  PROJECT
  STATUS_REPORT
  DOCUMENT
  OTHER
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  notificationEmail String?
  emailNotificationsEnabled Boolean @default(false)
  calendarProvider String?
  calendarEmail String?
  calendarRefreshToken String?
  calendarSyncEnabled Boolean @default(false)
  calendarConnectedAt DateTime?
  calendarLastSyncedAt DateTime?
  calendarSyncError String?
  password     String
  authProvider String      @default("LOCAL")
  ssoProvider  String?
  ssoSubject   String?
  ssoEmail     String?
  ssoLastLoginAt DateTime?
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret String?
  twoFactorConfirmedAt DateTime?
  twoFactorLastUsedStep Int?
  twoFactorRecoveryCodes String[] @default([])
  role         UserRole    @default(DEVELOPER)
  department   String      @default("Development")
  accessRoleId String?
  accessRole   AccessRole? @relation("UserAccessRole", fields: [accessRoleId], references: [id])
  createdAt    DateTime    @default(now())
  projects     Project[]
  tasks        Task[]      @relation("AssignedTasks")
  comments     Comment[]
  taskMarkers  TaskMarker[]
  auditLogs    AuditLog[]
  calendarSyncEvents CalendarSyncEvent[]
  statusReports ProjectStatusReport[] @relation("StatusReportAuthor")
  approvalRequests ApprovalRequest[] @relation("ApprovalRequester")
  approvalsToReview ApprovalRequest[] @relation("ApprovalApprover")
  ssoLoginTickets SsoLoginTicket[]

  @@unique([ssoProvider, ssoSubject])
}

model SsoLoginTicket {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@index([userId, createdAt])
}

model AccessRole {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  kind          AccessRoleKind
  description   String         @default("")
  businessAreas String[]       @default([])
  departmentIds String[]       @default([])
  permissions   Json
  system        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]         @relation("UserAccessRole")
}

model Project {
  id                   String                @id @default(cuid())
  name                 String
  key                  String                @unique
  description          String?
  color                String?
  deadline             DateTime?
  businessArea         String?
  projectGoal          String?
  plannedStart         DateTime?
  plannedEnd           DateTime?
  deputyLead           String?
  projectSponsor       String?
  plannedEffortPt      Float?
  plannedBudget        Float?
  keyInterfaces        String[]              @default([])
  collaborationQuality String?
  reportCycle          String                @default("MONTHLY")
  createdAt            DateTime              @default(now())
  ownerId              String
  owner                User                  @relation(fields: [ownerId], references: [id])
  tasks                Task[]
  milestones           ProjectMilestone[]
  risks                ProjectRisk[]
  budgetLines          ProjectBudgetLine[]
  statusReports        ProjectStatusReport[]
}

model ProjectMilestone {
  id         String    @id @default(cuid())
  title      String
  planDate   DateTime?
  newDate    DateTime?
  status     String    @default("OPEN")
  progress   Int       @default(0)
  statusNote String?
  order      Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model ProjectRisk {
  id          String   @id @default(cuid())
  code        String
  title       String
  description String?
  impact      Int?
  probability Int?
  riskClass   String?
  trend       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, active])
}

model ProjectBudgetLine {
  id            String   @id @default(cuid())
  category      String
  plannedAmount Float    @default(0)
  actualAmount  Float    @default(0)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, order])
}

model ProjectStatusReport {
  id                   String   @id @default(cuid())
  reportDate           DateTime @default(now())
  nextMeetingDate      DateTime?
  reportingPeriod      String?
  progress             Int      @default(0)
  goalStatus           String?
  scheduleStatus       String?
  resourceStatus       String?
  budgetStatus         String?
  progressNote         String?
  goalNote             String?
  scheduleNote         String?
  resourceNote         String?
  budgetNote           String?
  riskChanges          String?
  interfaceChanges     String?
  collaborationQuality String?
  nextSteps            String?
  actualEffortPt       Float?
  actualBudget         Float?
  versionLabel         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId             String?
  author               User?    @relation("StatusReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([projectId, reportDate])
  @@index([authorId, createdAt])
}

model ApprovalRequest {
  id          String             @id @default(cuid())
  entityType  ApprovalEntityType
  entityId    String
  entityLabel String
  title       String
  description String?
  status      ApprovalStatus     @default(PENDING)
  evidence    String?
  decisionNote String?
  requestedAt DateTime           @default(now())
  decidedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  requesterId String
  requester   User               @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approverId  String?
  approver    User?              @relation("ApprovalApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([status, requestedAt])
  @@index([requesterId, requestedAt])
  @@index([approverId, requestedAt])
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      TaskStatus  @default(OPEN)
  priority    Priority    @default(MEDIUM)
  order       Int         @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  endDate     DateTime?
  estimatedHours Float?
  department  String?
  markerId    String?
  approvalLevel String?
  projectId   String
  assigneeId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?       @relation("AssignedTasks", fields: [assigneeId], references: [id])
  comments    Comment[]
  calendarSyncEvents CalendarSyncEvent[]
}

model CalendarSyncEvent {
  id               String   @id @default(cuid())
  provider         String
  externalCalendarId String
  externalEventId  String
  taskId           String
  userId           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, userId, taskId])
  @@index([taskId, provider])
  @@index([userId, provider])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  taskId    String
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

model TaskMarker {
  id          String   @id @default(cuid())
  label       String
  description String   @default("")
  color       String
  matchField  String
  matchValue  String   @default("")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, order])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  entityLabel String?
  summary     String
  severity    String   @default("INFO")
  before      Json?
  after       Json?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  actorName   String
  actorEmail  String?
  actorRole   String?
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([severity])
}
