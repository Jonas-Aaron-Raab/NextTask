generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  QA
  BLOCKED
  DONE
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  DEVELOPER
  QA
  DESIGNER
  MARKETING
}

enum AccessRoleKind {
  ADMIN
  GBL
  MEMBER
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  password     String
  role         UserRole    @default(DEVELOPER)
  department   String      @default("Development")
  accessRoleId String?
  accessRole   AccessRole? @relation("UserAccessRole", fields: [accessRoleId], references: [id])
  createdAt    DateTime    @default(now())
  projects     Project[]
  tasks        Task[]      @relation("AssignedTasks")
  comments     Comment[]
}

model AccessRole {
  id            String         @id @default(cuid())
  name          String
  code          String         @unique
  kind          AccessRoleKind
  description   String         @default("")
  businessAreas String[]       @default([])
  departmentIds String[]       @default([])
  permissions   Json
  system        Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  users         User[]         @relation("UserAccessRole")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique
  description String?
  color       String?
  deadline    DateTime?
  createdAt   DateTime @default(now())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  tasks       Task[]
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      TaskStatus  @default(OPEN)
  priority    Priority    @default(MEDIUM)
  order       Int         @default(0)
  startDate   DateTime?
  dueDate     DateTime?
  endDate     DateTime?
  estimatedHours Float?
  department  String?
  projectId   String
  assigneeId  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?       @relation("AssignedTasks", fields: [assigneeId], references: [id])
  comments    Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  taskId    String
  authorId  String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}
