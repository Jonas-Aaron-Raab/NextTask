DATABASE_URL="postgresql://username:password@host:5432/database?sslmode=require"
JWT_SECRET="replace_with_a_secure_secret"
TWO_FACTOR_ISSUER="NextTask"
TWO_FACTOR_SECRET_KEY="replace_with_a_32_byte_random_secret"
PORT=5001

SSO_ENABLED="false"
SSO_PROVIDER="oidc"
SSO_DISPLAY_NAME="Sparkassen SSO"
SSO_ISSUER_URL="https://identity.example.com"
SSO_DISCOVERY_URL="https://identity.example.com/.well-known/openid-configuration"
SSO_CLIENT_ID="nexttask"
SSO_CLIENT_SECRET="replace_with_client_secret"
SSO_CLIENT_AUTH_METHOD="client_secret_basic"
SSO_REDIRECT_URI="http://localhost:5001/api/auth/sso/callback"
SSO_FRONTEND_REDIRECT_URI="http://localhost:5173/login"
SSO_SCOPES="openid profile email"
SSO_ALLOWED_EMAIL_DOMAINS="sparkasse.local,sparkasse.de"
SSO_AUTO_CREATE_USERS="true"
SSO_DEFAULT_ACCESS_ROLE_CODE="M-OR-IT"
SSO_DEFAULT_DEPARTMENT="Informationstechnologie OR-IT"
SSO_GROUPS_CLAIM="groups"
SSO_ADMIN_GROUPS=""
SSO_REQUIRE_VERIFIED_EMAIL="false"

APP_BASE_URL="http://localhost:5173"
GOOGLE_CALENDAR_CLIENT_ID="google-client-id"
GOOGLE_CALENDAR_CLIENT_SECRET="google-client-secret"
EMAIL_NOTIFICATIONS_ENABLED="false"
EMAIL_FROM="NextTask <notifications@example.com>"
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
